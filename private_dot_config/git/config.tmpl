[init]
        defaultBranch = main
[user]
        name = Karl Hans Laurits
        email = karl@laurits.dev
        signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[gpg]
        format = ssh
[core]
        fsmonitor = true
        untrackedCache = true
[tag]
        sort = version:refname
        gpgsign = true
[commit]
        verbose = true
        gpgsign = true
[push]
        autoSetupRemote = true
        followTags = true
[pull]
        rebase = true
[fetch]
        prune = true
        pruneTags = true
        all = true
[merge]
        conflictstyle = zdiff3
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true
[rerere]
        enabled = true
        autoupdate = true
[column]
        ui = auto
[branch]
        sort = -committerdate
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
[help]
        autocorrect = prompt
[credential "https://github.com"]
        helper =
        helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
        helper =
        helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
